# ============================================================
# Employee Operations AI - Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database (uses psycopg driver - psycopg3)
# Format: postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/employee_ops