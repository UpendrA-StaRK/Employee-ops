# ============================================================
# Employee Operations AI — Environment Configuration Example
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# .env is in .gitignore and will not be tracked.

# -----------------------------------------------------------
# Application
# -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------
# Database
# Driver:  psycopg (psycopg3) — psycopg[binary]>=3.2.0
# Format:  postgresql+psycopg://user:password@host:port/dbname
# -----------------------------------------------------------
DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/employee_ops

# -----------------------------------------------------------
# Test database (optional override)
# Defaults to DATABASE_URL + "_test" if not set.
# Format:  postgresql+psycopg://user:password@host:port/dbname_test
# -----------------------------------------------------------
# TEST_DATABASE_URL=postgresql+psycopg://postgres:changeme@localhost:5432/employee_ops_test