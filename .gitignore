# ============================================================
# Employee Operations AI — .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
wheels/
MANIFEST

# --- Virtual environments ---
.venv/
venv/
env/
.env

# --- uv ---
uv.lock          # Optionally commit this if you want reproducible installs.

# --- pytest ---
.pytest_cache/
.cache/
htmlcov/
.coverage
coverage.xml
coverage.json

# --- Alembic ---
# (migration scripts themselves are committed; only exclude local overrides)

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Generated / temporary data ---
data/generated/*
data/raw/*
data/rejected/*
data/quarantine/*
data/curated/*
data/pipeline_runs/*
data/spark_output/*
!data/generated/.gitkeep
!data/raw/.gitkeep
!data/rejected/.gitkeep
!data/curated/.gitkeep
!data/pipeline_runs/.gitkeep

# --- Logs ---
*.log

# --- OS ---
desktop.ini

# --- Project Notes & AI Memory ---
CLAUDE.md
AGENTS.MD
Fresher AI Training_Curriculam_Sep2026.md

# --- Custom Additions ---
$HOME/
fake_java/
generators/
